{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"lib": [
			"es2017",
			"dom"
		],
		"target": "es2017",
		"types": [
			"$app/types",
			"svelte",
			"@sveltejs/kit"
		],
		"checkJs": false
	},
	"exclude": [
		".svelte-kit/**",
		"node_modules/**"
	],
	"include": [
		"src",
		"vite.config.ts"
	]
}
